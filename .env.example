# Replace both values before running or deploying the admin portal.
ADMIN_PASSWORD=change-this-to-a-unique-password
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb://127.0.0.1:27017/spice_and_soul

# Optional: comma-separated website origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
